# Admin PIN for the admin UI (required): 4 to 6 digits, not 0000
ADMIN_PIN=
# Password of the bundled Postgres (required), e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=
# Host address the app port is bound to. Keep 127.0.0.1 when the reverse proxy
# runs on this machine; 0.0.0.0 only with a DOCKER-USER firewall rule (README)
POS_BIND=127.0.0.1
# Host port the server listens on
POS_PORT=3001
# Image tag: pin the released version (bump per release) rather than latest
POS_TAG=latest
